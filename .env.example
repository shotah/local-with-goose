# Environment configuration for Goose extensions
# Copy this file to .env and customize for your needs

# Web Search Configuration
# Enable web search capabilities
WEB_SEARCH_ENABLED=true
# Search API keys (if required by services)
DUCKDUCKGO_API_KEY=
TAVILY_API_KEY=
SEARXNG_API_URL=
BRAVE_SEARCH_API_KEY=

# API Access Tokens
OPENAI_API_KEY=
GITHUB_TOKEN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Tool Configuration
# Set the default search provider (duckduckgo, tavily, searxng)
SEARCH_PROVIDER=brave

# Rate limiting
MAX_SEARCH_RESULTS=10
SEARCH_TIMEOUT_SECONDS=10

# Logging
LOG_LEVEL=info
ENABLE_DEBUG_LOGS=false

# Model Settings
MODEL_CONTEXT_LENGTH=65536
ENABLE_FLASH_ATTENTION=true
KV_CACHE_TYPE=q8_0

# System Paths
WORKSPACE_PATH=./workspace
TEMPORARY_PATH=/tmp/goose